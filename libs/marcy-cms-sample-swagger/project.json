{
  "name": "marcy-cms-sample-swagger",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:noop",
      "outputs": ["libs/marcy-cms-sample-swagger"]
    },
    "codegen": {
      "executor": "@nx-dotnet/core:openapi-codegen",
      "options": {
        "openapiJsonPath": "libs/marcy-cms-sample-swagger/swagger.json",
        "outputProject": "generated-marcy-cms-types"
      },
      "dependsOn": ["^swagger"]
    },
    "version": {
      "executor": "@jscutlery/semver:version",
      "options": {
        "preset": "angular"
      }
    }
  },
  "implicitDependencies": ["marcy-cms-sample"]
}
