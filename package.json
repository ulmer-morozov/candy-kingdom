{
	"name": "@candy-kingdom/source",
	"version": "0.27.3",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/ulmer-morozov/candy-kingdom.git"
	},
	"scripts": {
		"bonnie:build": "nx build bonnie",
		"bonnie-cms:build": "nx build bonnie-cms",
		"bonnie-cms:dev": "nx serve bonnie-cms-sample --proxyConfig=\"apps/bonnie-cms-sample/proxy.conf.json\"",
		"marcy:build": "nx build marcy",
		"marcy:pack": "nx build marcy -extraParameters=\"-p:GeneratePackageOnBuild=true;Version=$(git describe --tag --abbrev=0 | cut -c 2-)\"",
		"marcy-cms:build": "nx build marcy-cms",
		"marcy-cms:pack": "nx build marcy-cms -extraParameters=\"-p:GeneratePackageOnBuild=true;Version=$(git describe --tag --abbrev=0 | cut -c 2-)\"",
		"marcy-cms:dev": "nx serve marcy-cms-sample",
		"marcy-gen:run": "dotnet run --project apps/marcy-gen",
		"cms-sample:dev": "nx run-many --parallel --target=serve --projects=\"marcy-cms-sample,bonnie-cms-sample\" --proxyConfig=\"apps/bonnie-cms-sample/proxy.conf.json\"",
		"dotnet:format": "dotnet format candy-kingdom.sln",
		"version-bump": "nx run bonnie:version --syncVersions --releaseAs=patch --allowEmptyRelease && git push --follow-tags",
		"prepare": "husky",
		"biome-check": "npx @biomejs/biome check --write ."
	},
	"private": true,
	"dependencies": {
		"@angular-devkit/build-angular": "21.1.5",
		"@angular/common": "21.1.6",
		"@angular/compiler": "21.1.6",
		"@angular/core": "21.1.6",
		"@angular/forms": "21.1.6",
		"@angular/platform-browser": "21.1.6",
		"@angular/platform-server": "21.1.6",
		"@angular/router": "21.1.6",
		"@angular/ssr": "21.1.5",
		"express": "^4.21.2",
		"rxjs": "~7.8.0"
	},
	"devDependencies": {
		"@angular-devkit/core": "21.1.5",
		"@angular-devkit/schematics": "21.1.5",
		"@angular/build": "21.1.5",
		"@angular/cdk": "21.1.6",
		"@angular/cli": "21.1.5",
		"@angular/compiler-cli": "21.1.6",
		"@angular/language-service": "21.1.6",
		"@biomejs/biome": "2.4.4",
		"@commitlint/cli": "^18.0.0",
		"@commitlint/config-angular": "^18.0.0",
		"@eslint/js": "^9.8.0",
		"@jscutlery/semver": "^5.7.1",
		"@nx/angular": "22.6.1",
		"@nx/dotnet": "22.6.1",
		"@nx/eslint": "22.6.1",
		"@nx/eslint-plugin": "22.6.1",
		"@nx/js": "22.6.1",
		"@nx/web": "22.6.1",
		"@nx/workspace": "22.6.1",
		"@schematics/angular": "21.1.5",
		"@swc-node/register": "1.11.1",
		"@swc/core": "1.15.8",
		"@swc/helpers": "0.5.19",
		"@types/express": "^4.17.21",
		"@types/node": "20.19.9",
		"@typescript-eslint/utils": "^8.40.0",
		"angular-eslint": "21.3.1",
		"autoprefixer": "^10.4.0",
		"eslint": "^9.8.0",
		"eslint-config-prettier": "^10.0.0",
		"husky": "^9.0.0",
		"jsonc-eslint-parser": "^2.1.0",
		"ng-packagr": "21.1.0",
		"nx": "22.6.1",
		"postcss": "^8.4.5",
		"postcss-url": "~10.1.3",
		"prettier": "~3.6.2",
		"tslib": "^2.3.0",
		"typescript": "~5.9.2",
		"typescript-eslint": "^8.40.0",
		"verdaccio": "^6.0.5"
	},
	"nx": {
		"includedScripts": []
	}
}
