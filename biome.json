{
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							":NODE:",
							"@angular/**",
							":BLANK_LINE:",
							["three", "three/**"],
							":BLANK_LINE:",
							[":PACKAGE:", "!@candy-kingdom/**"],
							":BLANK_LINE:",
							"@candy-kingdom/**",
							":BLANK_LINE:",
							":URL:",
							":BLANK_LINE:",
							":PATH:",
							":BLANK_LINE:",
							"./**"
						]
					}
				}
			}
		}
	},
	"formatter": {
		"lineWidth": 100
	},
	"linter": {
		"rules": {
			"complexity": {
				"noForEach": "off",
				"useLiteralKeys": "off"
			},
			"suspicious": {
				"noDebugger": "off",
				"useIterableCallbackReturn": "off"
			},
			"correctness": {
				"useImportExtensions": "off"
			},
			"style": {
				"useNamingConvention": {
					"level": "error",
					"options": {
						"strictCase": false,
						"conventions": [
							{
								"selector": {
									"kind": "importNamespace"
								},
								"formats": ["camelCase", "CONSTANT_CASE"]
							},
							{
								"selector": {
									"kind": "typeProperty"
								},
								"formats": ["camelCase", "snake_case"]
							},
							{
								"selector": {
									"kind": "classProperty",
									"modifiers": ["static", "readonly"]
								},
								"formats": ["camelCase", "PascalCase"]
							},
							{
								"selector": {
									"kind": "classProperty",
									"modifiers": ["private", "readonly"]
								},
								"match": "_(.+)",
								"formats": ["camelCase", "snake_case", "PascalCase"]
							},
							{
								"selector": {
									"kind": "classProperty",
									"modifiers": ["private"]
								},
								"match": "_?(.+)",
								"formats": ["camelCase", "snake_case", "PascalCase"]
							},
							{
								"selector": {
									"kind": "classProperty"
								},
								"formats": ["camelCase", "snake_case", "PascalCase"],
								"match": "\\$?(.+)"
							}
						]
					}
				}
			}
		}
	}
}
