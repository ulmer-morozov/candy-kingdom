{
  "name": "bonnie-cms-sample",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "candy-kingdom",
  "sourceRoot": "apps/bonnie-cms-sample/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/bonnie-cms-sample/browser",
        "index": "apps/bonnie-cms-sample/src/index.html",
        "main": "apps/bonnie-cms-sample/src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "apps/bonnie-cms-sample/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/bonnie-cms-sample/src/favicon.ico",
          "apps/bonnie-cms-sample/src/assets"
        ],
        "styles": [
          "apps/bonnie-cms-sample/src/styles.scss"
        ],
        "stylePreprocessorOptions": {
          "includePaths": [
            "libs/bonnie-cms/src/lib/styles"
          ]
        },
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "bonnie-cms-sample:build:production"
        },
        "development": {
          "buildTarget": "bonnie-cms-sample:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "bonnie-cms-sample:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/bonnie-cms-sample/jest.config.ts"
      }
    },
    "server": {
      "dependsOn": [
        "build"
      ],
      "executor": "@angular-devkit/build-angular:server",
      "options": {
        "outputPath": "dist/apps/bonnie-cms-sample/server",
        "main": "apps/bonnie-cms-sample/server.ts",
        "tsConfig": "apps/bonnie-cms-sample/tsconfig.server.json",
        "inlineStyleLanguage": "scss",
        "stylePreprocessorOptions": {
          "includePaths": [
            "libs/bonnie-cms/src/lib/styles"
          ]
        }
      },
      "configurations": {
        "production": {
          "outputHashing": "media"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "sourceMap": true,
          "extractLicenses": false,
          "vendorChunk": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve-ssr": {
      "executor": "@angular-devkit/build-angular:ssr-dev-server",
      "configurations": {
        "development": {
          "browserTarget": "bonnie-cms-sample:build:development",
          "serverTarget": "bonnie-cms-sample:server:development"
        },
        "production": {
          "browserTarget": "bonnie-cms-sample:build:production",
          "serverTarget": "bonnie-cms-sample:server:production"
        }
      },
      "defaultConfiguration": "development"
    },
    "prerender": {
      "executor": "@angular-devkit/build-angular:prerender",
      "options": {
        "routes": [
          "/"
        ]
      },
      "configurations": {
        "development": {
          "browserTarget": "bonnie-cms-sample:build:development",
          "serverTarget": "bonnie-cms-sample:server:development"
        },
        "production": {
          "browserTarget": "bonnie-cms-sample:build:production",
          "serverTarget": "bonnie-cms-sample:server:production"
        }
      },
      "defaultConfiguration": "production"
    },
    "version": {
      "executor": "@jscutlery/semver:version",
      "options": {
        "preset": "angular"
      }
    }
  }
}
